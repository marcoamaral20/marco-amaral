---
import HeroConvergence from "../components/convergence/HeroConvergence.astro";
import { buildWhatsAppUrl, GENERIC_WHATSAPP_MESSAGE } from "../config/contact";
import "../styles/sections/hero.css";

const heroContactUrl = buildWhatsAppUrl(GENERIC_WHATSAPP_MESSAGE);
---

<section class="hero" aria-labelledby="hero-title">
  <HeroConvergence />

  <div class="hero__copy">
    <p class="hero__eyebrow">Software Developer</p>

    <h1 class="hero__headline" id="hero-title">
      <span class="hero__headline-line">Clareza também</span>
      <span class="hero__headline-line">é engenharia.</span>
    </h1>

    <p class="hero__supporting" data-hero-supporting>
      Entender o problema, encontrar sua estrutura e construir um sistema real
      fazem parte do mesmo trabalho.
    </p>

    <a
      class="hero__contact"
      href={heroContactUrl}
      target="_blank"
      rel="noreferrer">Conversar sobre um projeto</a
    >
  </div>
</section>

<script src="../scripts/hero-motion.ts"></script>
